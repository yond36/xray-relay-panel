XRAY_PANEL_BIND=0.0.0.0:8080
XRAY_PANEL_DATA=./.local/panel
XRAY_PANEL_SECURE_COOKIES=0
# Optional: Base64 or hex encoded 32-byte master key. Back it up separately.
# XRAY_RELAY_PANEL_MASTER_KEY=
# Optional: absolute path to a Linux ELF node helper for SSH-managed nodes.
# XRAY_PANEL_NODECTL=/opt/xray-relay-panel/xray-panel-nodectl
